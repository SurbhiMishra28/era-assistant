# DentEra environment — copy to .env and fill in
PORT=8100
JWT_SECRET=change-me-to-a-long-random-string
# SQLite file (falls back to server/db/dental.db, then tmpdir)
DB_FILE=
# Voice: NVIDIA NVCF key (or put it in nvcf.key). Without it, text replies still work.
NVIDIA_API_KEY=
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8100
# Demo personas on the login page (1 = on)
DEMO_LOGIN=1
